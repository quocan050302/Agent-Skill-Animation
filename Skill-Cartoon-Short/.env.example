# Cartoon Short Renderer (SHORT-01) — Local Environment Configuration
# Optional path to local cartoon-short-kit.zip for clean-clone hydration
CARTOON_SHORT_KIT_ZIP=/Users/macbook/Downloads/cartoon-short-kit.zip

# Loopback-only server bind host (never 0.0.0.0)
SHORT_RENDER_HOST=127.0.0.1
SHORT_VIEWER_PORT=4319

# Resource limits
SHORT_MAX_RENDER_WORKERS=1
SHORT_MIN_FREE_DISK_MB=1024
SHORT_JOB_TIMEOUT_MS=300000
