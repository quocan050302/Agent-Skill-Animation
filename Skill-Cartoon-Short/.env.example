# Local Cartoon Short Studio Environment Example
# Copy to .env locally (NEVER commit .env or real API keys)

# Optional: Google Gemini API key for live Gemini TTS synthesis and model discovery
GEMINI_API_KEY=

# Optional: Loopback Studio server port (defaults to 4319; binds strictly to 127.0.0.1)
SHORT_VIEWER_PORT=4319

# Optional: Minimum free disk reserve in MB before render jobs start (defaults to 1024)
SHORT_MIN_FREE_DISK_MB=1024

# Optional: Bounded WebGL render worker concurrency (1 or 2; defaults to 1)
SHORT_MAX_RENDER_WORKERS=1
