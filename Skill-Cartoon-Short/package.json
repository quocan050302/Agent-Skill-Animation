{
  "name": "skill-cartoon-short",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cartoon Short Studio (2D + 3D, 9:16, 1080x1920, 30 FPS) — Voice Studio, Cartoon Subtitles & Verified Render Pipeline",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "setup": "node tools/setup/hydrate.mjs",
    "render": "node tools/render/render-cli.mjs",
    "viewer": "node app/server/viewer-server.mjs",
    "studio": "node app/server/viewer-server.mjs",
    "dev": "vite --config app/frontend/vite.config.ts",
    "dev:api": "node app/server/viewer-server.mjs",
    "typecheck": "tsc -p app/frontend/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build --config app/frontend/vite.config.ts",
    "preview": "vite preview --config app/frontend/vite.config.ts --host 127.0.0.1",
    "test": "node tests/run-dag.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:regression": "node --test tests/regression/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "qa": "node tools/qa/verify-gates.mjs"
  },
  "dependencies": {
    "playwright": "1.65.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
